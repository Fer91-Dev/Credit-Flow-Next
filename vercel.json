{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "regions": [
    "gru1"
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "credit-flow-next.vercel.app"
        }
      ],
      "destination": "https://creditzeroapp.com.ar/$1",
      "permanent": false
    }
  ]
}
