generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODELO ORG (multi-usuario por financiera)
//
// `tenants`  = la financiera (organización). Es el TENANT real del sistema.
// `profiles` = la persona que loguea (= auth.users.id), pertenece a un tenant y
//              tiene un ROL. Fuente de verdad del control de acceso.
//
// Toda tabla operativa se aísla por `tenant_id` (antes `user_id`, resignificado).
// El aislamiento se aplica en la capa app (`withTenant`) + RLS de Postgres.
// ─────────────────────────────────────────────────────────────────────────────

/// Roles de acceso dentro de una financiera (tenant). Deny-by-default: un profile
/// sin rol (role = null) o inactivo NO tiene acceso a nada.
enum Role {
  admin // Dueño/gerente: acceso total (Reportes, Caja, Configuración, Auditoría)
  vendedor // Comercial: ABM clientes + alta/simulación de créditos + cobranza y caja de SUS clientes
  cobrador // DEPRECADO — el vendedor hace su propia cobranza. No se crea ni tiene acceso (UI/API/rutas
  // ya no lo permiten). El valor queda en el enum para no romper filas legacy; no migrar.
}

/// Financiera / organización. Es el "tenant" del sistema multi-tenant.
/// Toda la data operativa pertenece a un tenant; las personas (profiles) también.
model tenants {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  nombre     String // nombre de fantasía / display de la financiera
  activo     Boolean  @default(true)
  // Entitlements: claves de features premium habilitadas para este tenant (gating por
  // plan del SaaS). Ver lib/entitlements.ts (FEATURES). Vacío = solo features base.
  features   String[] @default([])

  // Identidad de la financiera (Datos de la financiera). La edita el admin del tenant;
  // alimenta el co-branding (sidebar/Home/PDFs) y la facturación futura.
  razon_social   String?
  cuit           String?
  direccion      String?
  telefono       String?
  email          String?
  logo_url       String? // logo en Supabase Storage (co-branding)
  // Domicilio estructurado (georef AR: provincia→localidad; igual que clientes)
  provincia      String?
  localidad      String?
  codigo_postal  String?
  tipo_domicilio String?
  piso           String?
  depto          String?

  profiles    profiles[]
  suscripcion suscripciones?
}

/// Suscripción del tenant al SaaS (facturación por plan). Una fila por tenant. El plan
/// define qué features premium tiene (ver lib/planes.ts → sincroniza tenants.features).
/// `proveedor` = manual (activación a mano) | mercadopago | paddle (automáticos, a futuro).
model suscripciones {
  tenant_id     String    @id @db.Uuid
  plan          String    @default("free") // free | pro
  estado        String    @default("activa") // activa | vencida | cancelada
  proveedor     String    @default("manual") // manual | mercadopago | paddle
  monto         Float     @default(0) // importe mensual acordado (informativo en modo manual)
  periodo_desde DateTime? @db.Timestamptz(6)
  periodo_hasta DateTime? @db.Timestamptz(6) // vencimiento del período pago (null = sin vencimiento)
  notas         String?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)

  tenant tenants @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
}

/// Identidad de un usuario autenticado (= auth.users.id) dentro de una financiera.
/// Fuente de verdad del ROL. La FK profiles.id → auth.users(id) y el trigger de
/// alta (handle_new_user) se manejan a nivel SQL (Supabase no es modelable por Prisma).
///
/// Deny-by-default: un profile recién creado nace con tenant_id = null, role = null
/// y activo = false → sin acceso a nada hasta que un admin lo asigne y active.
model profiles {
  id          String   @id @db.Uuid // = auth.users.id (Supabase Auth)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  // Nombre para MOSTRAR. Se lee en ~42 lugares (saludo del Home, actor de auditoría,
  // listas de Usuarios/Agentes, emails). NO se elimina: se RECALCULA como
  // "nombre apellido" cada vez que se guarda el perfil, así todos esos usos siguen
  // funcionando sin tocarlos.
  full_name   String?
  email       String?
  // Alias de login opcional: el admin lo asigna. Permite ingresar con usuario O email.
  // Único GLOBAL (como el email); se guarda SIEMPRE en minúscula → unicidad case-insensitive.
  // No reemplaza al email (Supabase autentica por email); es un alias que resolvemos a email.
  username    String?  @unique
  tenant_id   String?  @db.Uuid // nullable: deny-by-default hasta asignar
  role        Role? // nullable: sin rol = acceso denegado
  activo      Boolean  @default(false) // inerte hasta que el admin lo active
  vendedor_id String?  @db.Uuid // vínculo opcional al registro comercial (si role = vendedor)
  // Dueño de la PLATAFORMA (SaaS), distinto del admin de una financiera. Fuente de verdad
  // del acceso al área "Administración del SaaS". Se asigna con scripts/set-owner.mjs.
  es_owner    Boolean  @default(false)
  // TITULAR de la financiera: el admin dueño del negocio. Distinto de `es_owner`, que es
  // el dueño del SaaS. Sin esto, todos los admin de un tenant eran intercambiables y
  // cualquiera podía eliminar, degradar, desactivar o CAMBIARLE LA CONTRASEÑA al dueño
  // —quedándose con su cuenta sin borrar nada y sin que él se entere—. Solo el propio
  // titular puede modificarse a sí mismo; ningún otro admin puede tocarlo.
  // Se asigna con scripts/set-titular.mjs (uno por tenant).
  es_titular  Boolean  @default(false)

  // ── Datos personales de la persona que loguea ────────────────────────────────
  // `profiles` es la FUENTE DE VERDAD de estos campos (decisión 2026-07-30): los
  // edita cada uno desde "Mi perfil" y la ficha de Agentes los muestra en solo
  // lectura, quedándose con lo laboral (fecha_ingreso, zona, comisión, meta,
  // límite). Van acá y no en `vendedores` porque no todo usuario tiene ficha de
  // agente — hoy 2 de 3 (el owner y el admin de la financiera) no la tienen.
  // Todos opcionales: son aditivos y no bloquean ninguna cuenta existente.
  nombre           String?
  apellido         String?
  telefono         String? // celular de contacto
  fecha_nacimiento DateTime? @db.Date

  // Domicilio estructurado — MISMO patrón y nombres que `clientes` (georef AR:
  // provincia→localidad, CP manual; tipo_domicilio = casa | departamento, y si es
  // departamento se cargan piso y depto). Reusa el componente DomicilioFields.
  direccion      String?
  provincia      String?
  localidad      String?
  codigo_postal  String?
  tipo_domicilio String?
  piso           String?
  depto          String?

  tenant   tenants?    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  vendedor vendedores? @relation(fields: [vendedor_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
}

model clientes {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  nombre        String // nombre(s) de pila
  apellido      String? // apellido(s) — separado de nombre (modelo normalizado)
  documento     String?
  email         String?
  telefono      String?
  direccion     String?
  // activo | fallecido. Solo un ADMIN puede moverlo (ver PATCH /api/clientes/[id]).
  estado        String    @default("activo")
  // Por qué se cambió el estado. Obligatorio al marcar fallecido: el acta de defunción se
  // pide y se archiva EN PAPEL (decisión del usuario), así que el sistema solo guarda el
  // relato de quién lo registró. Sin esto, un cliente quedaría marcado sin explicación.
  estado_motivo String?
  // Fecha del deceso. Es la que FRENA LOS PUNITORIOS: desde acá la deuda deja de crecer,
  // porque nadie va a pagar una cuota después de muerto. Se guarda aparte del `created_at`
  // de la auditoría: una cosa es cuándo murió y otra cuándo se enteró la financiera.
  estado_fecha  DateTime? @db.Date

  /**
   * NO CONTACTAR — el cliente pidió que no lo llamen ni le escriban.
   * Distinto de `estado`: el titular sigue vivo y la deuda sigue viva y exigible; lo único
   * que cambia es el CANAL. Se le puede cobrar, se le puede refinanciar y aparece en la
   * cartera; lo que no se puede es mandarle un mensaje.
   * 🔴 NO es un parámetro de la financiera, y por eso no vive en `configuraciones`: es un
   * pedido del titular. En Argentina, insistir después de que alguien pidió que no lo
   * contacten es exposición directa bajo la ley de Defensa del Consumidor. Que una
   * financiera pueda "desactivar" el respeto a ese pedido sería el único uso posible del
   * toggle, así que el toggle no existe.
   */
  no_contactar        Boolean   @default(false)
  /**
   * Qué pidió exactamente (por escrito, por teléfono, solo al celular, etc.). Obligatorio al activarlo.
   */
  no_contactar_motivo String?
  /**
   * Cuándo se registró el pedido.
   */
  no_contactar_desde  DateTime? @db.Timestamptz(6)
  tipo_credito        String    @default("personal")
  monto_total         Float     @default(0)
  zona                String? // zona/barrio para segmentación geográfica (Fase Home)
  tenant_id           String    @db.Uuid

  // Datos personales ampliados
  fecha_nacimiento DateTime? @db.Date
  cuit_cuil        String?
  estado_civil     String?
  nacionalidad     String?

  // Domicilio estructurado (georef AR: provincia→localidad; CP manual). tipo_domicilio =
  // casa | departamento; si es departamento se cargan piso y depto (ej. 3° C).
  provincia      String?
  localidad      String?
  codigo_postal  String?
  tipo_domicilio String?
  piso           String?
  depto          String?

  // Situación laboral
  situacion_laboral        String? // relacion_dependencia | autonomo | monotributista | jubilado | desempleado | otro
  ocupacion                String?
  empleador                String?
  antiguedad_laboral_meses Int?

  // Ingresos / capacidad de pago
  ingreso_mensual   Float?
  otros_ingresos    Float?
  // Anti-fraude: veces que un VENDEDOR editó el sueldo. Al superar el máximo (política), el
  // campo se bloquea para vendedores hasta que un ADMIN resetee el contador. El sueldo es la
  // variable central del motor financiero; sin este control un vendedor podría inflarlo.
  ingreso_ediciones Int    @default(0)

  // Consentimiento del titular para consultar bureaus de crédito (Ley 25.326 - habeas data).
  // Requisito legal para consultar BCRA/Nosis/Veraz (no aplica al modo manual).
  consentimiento_bureau Boolean @default(false)

  // Contacto laboral
  telefono_laboral  String?
  direccion_laboral String?

  // Migración de cartera vieja (planilla del sistema anterior): `migrado` marca el cliente en
  // la ficha como importado (editable/completar después — apodos por nombre real, DNI, etc.);
  // `historial_migrado` guarda su HISTORIA CLÍNICA (créditos previos: monto/cuota/estado/saldo
  // + perfil). Es solo referencia: NO genera caja, cuotas ni mora. Lo nuevo va por el flujo normal.
  migrado           Boolean @default(false)
  historial_migrado Json?

  creditos         creditos[]
  solicitudes      solicitudes[]
  consultas_bureau consultas_bureau[]

  // El identificador ÚNICO es el CUIT/CUIL (en AR puede haber DNI repetidos). Los
  // null se permiten (Postgres los trata como distintos): clientes sin CUIT cargado.
  // El DNI repetido se admite si el CUIT lo diferencia (validado en la API).
  @@unique([tenant_id, cuit_cuil])
  @@index([tenant_id])
}

/// Consultas a bureaus de crédito (BCRA/Nosis/Veraz/manual) de un cliente. Snapshot +
/// cache + auditoría de la evaluación externa. Feature premium (motor de riesgo).
model consultas_bureau {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String   @db.Uuid
  cliente_id         String   @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  proveedor          String // bcra | nosis | veraz | manual
  cuit               String? // documento consultado (11 dígitos)
  ok                 Boolean  @default(true) // si la consulta se resolvió sin error
  mensaje            String? // error o nota
  situacion_bcra     Int? // 1..6 (peor situación informada)
  score_externo      Int? // 0..1000 (Nosis/Veraz)
  cheques_rechazados Int?
  deuda_sistema      Float? // deuda total informada en el sistema financiero
  crudo              Json? // payload normalizado + crudo del proveedor
  usuario_id         String?  @db.Uuid // quién consultó (auditoría)
  usuario_nombre     String?

  cliente clientes @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, cliente_id, created_at])
}

model creditos {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  numero           Int? // identificador legible secuencial por tenant (se muestra como CRD-000123)
  motivo_anulacion String? // motivo registrado al anular el crédito
  cliente_id       String    @db.Uuid
  solicitud_id     String?   @db.Uuid
  tipo_credito     String
  monto_original   Float
  saldo_pendiente  Float
  tasa             Float     @default(0)
  plazo_meses      Int       @default(12) // número de cuotas (el período lo da `frecuencia`)
  frecuencia       String    @default("mensual") // clave de frecuencia (built-in o personalizada)
  frecuencia_def   Json? // snapshot de la definición de frecuencia vigente al otorgar (congela días/períodos)
  fecha_inicio     DateTime  @default(now()) @db.Date
  proximo_pago     DateTime? @db.Date
  dias_mora        Int       @default(0)
  estado           String    @default("activo")
  cargos           Json? // snapshot de CargosConfig vigente al otorgar (congela los cargos del crédito)
  cronograma       Json? // snapshot del cronograma (corte/día venc/gracia/feriados) vigente al otorgar
  tenant_id        String    @db.Uuid

  vendedor_id String? @db.Uuid // vendedor que otorgó el crédito (Fase 5, opcional)

  // QUIÉN otorgó, que NO es lo mismo que `vendedor_id`.
  //
  // `vendedor_id` es a quién se le atribuye la venta (comisión, meta, ranking) y queda en
  // null cuando otorga la casa. Con un solo administrador eso era inequívoco —fue él—, pero
  // en cuanto hay dos, todos los créditos de la casa caen en la misma fila y no se distinguen.
  //
  // El nombre va congelado además del id porque la cuenta se puede borrar o renombrar, y la
  // pregunta "¿quién dio este crédito?" tiene que seguir teniendo respuesta dentro de cinco
  // años. Mismo criterio que los snapshots de `cargos` y `cronograma`.
  otorgado_por        String? @db.Uuid // profiles.id del usuario que ejecutó el otorgamiento
  otorgado_por_nombre String? // nombre al momento de otorgar (sobrevive al borrado de la cuenta)

  // Refinanciación / reestructuración: un crédito moroso se cierra y su deuda viva
  // se consolida como capital de un crédito NUEVO. No mueve plata real (no hay
  // desembolso). Los punteros vinculan ambos créditos; el flag excluye al nuevo del
  // cómputo de comisión/meta (no es plata nueva otorgada).
  es_refinanciacion Boolean @default(false) // true = nació de una reestructuración
  refinancia_a      String? @db.Uuid // (en el nuevo) crédito original que reemplaza
  refinanciado_en   String? @db.Uuid // (en el viejo) refinanciación que lo reemplazó

  // Crédito de PRODUCTO (tipo_credito = "productos"): en vez de desembolsar dinero, el
  // cliente se lleva un producto del inventario. El capital = precio × cantidad y NO mueve
  // caja (sin desembolso); el control es el descuento de stock. El valor ya queda snapshot
  // en monto_original, por eso el SetNull no rompe el histórico financiero.
  producto_id       String? @db.Uuid // producto financiado (null = crédito de dinero)
  producto_cantidad Int? // unidades financiadas (capital = precio × cantidad)
  // Snapshot de la evaluación de riesgo/originación al otorgar (feature premium): semáforo,
  // motivos, ratio, ingreso, score y si se autorizó manualmente. Congela la decisión.
  riesgo_snapshot   Json?

  cliente           clientes            @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  solicitud         solicitudes?        @relation(fields: [solicitud_id], references: [id], onDelete: SetNull)
  vendedor          vendedores?         @relation(fields: [vendedor_id], references: [id], onDelete: SetNull)
  producto          productos?          @relation(fields: [producto_id], references: [id], onDelete: SetNull)
  pagos             pagos[]
  acciones          acciones_cobranza[]
  acuerdos          acuerdos_pago[]
  cuotas            cuotas[]
  movimientos       movimientos_caja[]
  movimientos_stock movimientos_stock[]
  objetivos_campana campana_objetivo[]

  // ── Documentación del crédito (solicitud/mutuo + pagaré) ──
  // Estado del PAPEL, distinto del estado del crédito: un crédito puede estar activo y
  // cobrándose sin que nadie haya devuelto el contrato firmado. Sin esto no había forma
  // de saber qué parte de la cartera está respaldada por un documento ejecutable.
  //   sin_emitir → nunca se generó · emitido → se imprimió, falta la firma
  //   firmado    → el cliente devolvió el papel firmado (lo marca un humano)
  doc_estado     String    @default("sin_emitir")
  doc_emitido_en DateTime? @db.Timestamptz(6)
  doc_firmado_en DateTime? @db.Timestamptz(6)

  @@unique([tenant_id, numero])
  @@index([tenant_id, vendedor_id])
  @@index([tenant_id, producto_id])
}

/// Catálogo de productos vendidos a crédito (inventario). Tabla aditiva, multi-tenant.
/// Un crédito de tipo "productos" financia un producto en vez de dinero: el cliente se
/// lleva el producto y el `precio` se toma como capital. Otorgar descuenta `stock`;
/// anular/eliminar lo repone. No mueve caja (no hay desembolso de efectivo).
model productos {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  tenant_id    String   @db.Uuid
  nombre       String
  categoria    String? // texto; el simulador arma el selector con las categorías existentes
  descripcion  String?
  sku          String? // código interno opcional
  precio       Float    @default(0) // precio de venta = capital del crédito
  stock        Int      @default(0) // unidades disponibles
  stock_minimo Int? // umbral de alerta de bajo stock (opcional)
  imagen_url   String? // foto de PORTADA (= imagenes[0]); se mantiene para miniaturas/listas
  imagenes     String[] @default([]) // galería de hasta 5 fotos (la 1ª es la portada)
  activo       Boolean  @default(true)

  creditos    creditos[]
  movimientos movimientos_stock[]

  @@index([tenant_id])
}

/// Kardex de stock: libro mayor de movimientos de inventario por producto.
/// Igual que `movimientos_caja` (con signo), es la FUENTE DE VERDAD auditable del stock;
/// `productos.stock` es un cache sincronizado en la misma transacción. Todo cambio de
/// stock (alta, entrada/reposición, venta a crédito, devolución por anulación, ajuste)
/// queda registrado acá → trazable y reconciliable, sin ediciones silenciosas.
model movimientos_stock {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  tenant_id        String   @db.Uuid
  producto_id      String   @db.Uuid
  tipo             String // alta_inicial | entrada | venta_credito | devolucion_anulacion | ajuste
  cantidad         Int // CON SIGNO: entrada/devolución/alta > 0, venta < 0, ajuste ±
  stock_resultante Int // snapshot del stock luego de aplicar (kardex con saldo)
  motivo           String? // obligatorio en ajuste; nota/proveedor en entrada
  credito_id       String?  @db.Uuid // venta_credito / devolucion_anulacion
  usuario_id       String?  @db.Uuid // actor (capturado al escribir, igual que auditoria)
  usuario_nombre   String?

  producto productos @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  credito  creditos? @relation(fields: [credito_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, producto_id, created_at])
}

/// Personal de ventas/cobranza (Fase 5). Tabla aditiva, multi-tenant.
/// Registro COMERCIAL del vendedor (comisión, meta). La identidad de login y el rol
/// real viven en `profiles` (profiles.vendedor_id → vendedores.id).
/// `rol` (texto) queda por retrocompatibilidad; se deprecará en una fase posterior.
model vendedores {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  tenant_id    String   @db.Uuid
  nombre       String
  email        String?
  telefono     String?
  rol          String   @default("vendedor") // DEPRECADO (ver profiles.role): vendedor | supervisor | cobrador | admin
  comision_pct Float    @default(0) // % de comisión sobre el monto otorgado
  meta_venta   Float    @default(0) // meta de venta del período (0 = sin meta)
  activo       Boolean  @default(true)

  // Datos laborales y parametrización del empleado (Fase 1)
  documento         String? // DNI / CUIL
  fecha_ingreso     DateTime? @db.Date
  direccion         String?
  zona              String? // zona o sucursal asignada
  notas             String? // notas internas
  limite_aprobacion Float? // monto máximo que puede otorgar sin autorización (null = sin límite)
  comision_config   Json? // comisión avanzada (Fase 2): { base_pct, por_tipo, tramos, bonus_meta }. null = % plano

  creditos         creditos[]
  profiles         profiles[] // back-relation del vínculo profiles.vendedor_id
  metas            metas_vendedor[]
  movimientos_caja movimientos_caja[] // caja personal del vendedor (Fase caja por vendedor)
  arqueos          arqueos_caja[] // cierres de su caja
  liquidaciones    liquidaciones_comision[]

  @@index([tenant_id])
}

/**
 * Liquidación de comisiones — el comprobante de lo que se le PAGÓ a un agente.
 * Existe porque la comisión se calculaba siempre en vivo: bajarle el `comision_pct` a
 * un vendedor, o anular un crédito viejo, reescribía cuánto se le había pagado el mes
 * anterior. Sin este registro, ninguna discusión con un vendedor sobre un pago tiene
 * respaldo.
 * Es un SNAPSHOT: los montos, la config de comisión usada y el detalle crédito por
 * crédito quedan congelados al liquidar y no se recalculan nunca más. Mismo criterio
 * que `creditos.cronograma` / `cargos` / `riesgo_snapshot`.
 * NO se edita. Si algo salió mal se ANULA (revierte el movimiento de caja) y se genera
 * otra — igual que un crédito.
 */
model liquidaciones_comision {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  tenant_id   String   @db.Uuid
  vendedor_id String   @db.Uuid

  // Qué se liquidó
  periodo     String // etiqueta: "2026-08", "2026-T3", "2026"
  fecha_desde DateTime @db.Date
  fecha_hasta DateTime @db.Date

  // Base del cálculo (congelada)
  monto_otorgado    Float @default(0)
  creditos_cantidad Int   @default(0)

  // El número que se paga (congelado)
  comision_base  Float @default(0) // base + por tipo + tramos
  comision_bonus Float @default(0) // bonus por meta (0 si no llegó)
  comision_total Float @default(0)

  // Por qué dio eso (congelado)
  meta_monto               Float   @default(0)
  meta_cumplida            Boolean @default(false)
  comision_pct_snapshot    Float   @default(0)
  comision_config_snapshot Json? // config avanzada vigente al liquidar (null = % plano)
  detalle                  Json // [{ credito_id, numero, cliente, monto, pct, comision }]

  // Trazabilidad
  estado               String    @default("pagada") // pagada | anulada
  movimiento_caja_id   String?   @db.Uuid // el egreso en la caja principal
  cuenta               String    @default("efectivo") // efectivo | banco | dolares
  liquidado_por        String?   @db.Uuid // profiles.id de quien liquidó
  liquidado_por_nombre String?
  notas                String?
  anulada_en           DateTime? @db.Timestamptz(6)
  anulada_motivo       String?

  vendedor vendedores @relation(fields: [vendedor_id], references: [id], onDelete: Cascade)

  // NO lleva `@@unique([tenant_id, vendedor_id, periodo])`. Lo tuvo, y estaba mal: un
  // unique no distingue estados, así que una liquidación ANULADA seguía ocupando el
  // período y no se podía volver a liquidar (fallaba con "Recurso duplicado", el error
  // crudo de Postgres). Anular tiene que dejar rehacer — es para lo que existe.
  //
  // El candado real es el chequeo de SOLAPAMIENTO en `liquidarComision`, que además es
  // más fuerte: ignora las anuladas y también atrapa rangos que se pisan con etiquetas
  // distintas ("2026-07" contra "01/07 al 15/07"), algo que el unique nunca vio. Corre
  // dentro de la transacción y bajo advisory lock por (tenant, vendedor), así que dos
  // liquidaciones simultáneas no pueden colarse.
  @@index([tenant_id, fecha_desde])
  @@index([tenant_id, vendedor_id])
}

/// Metas/objetivos de un vendedor por período (Fase 3). Aditiva, multi-tenant.
/// Permite metas de monto, cantidad de créditos y cobranza, con histórico. La
/// meta "vigente" sincroniza vendedores.meta_venta para los KPIs existentes.
model metas_vendedor {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  tenant_id     String   @db.Uuid
  vendedor_id   String   @db.Uuid
  periodo       String // etiqueta del período, ej. "2026-06" o "2026-T2"
  fecha_desde   DateTime @db.Date
  fecha_hasta   DateTime @db.Date
  meta_monto    Float    @default(0) // objetivo de monto otorgado
  meta_cantidad Int      @default(0) // objetivo de cantidad de créditos
  meta_cobranza Float    @default(0) // objetivo de monto cobrado/recuperado
  estado        String   @default("vigente") // vigente | cerrada

  vendedor vendedores @relation(fields: [vendedor_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([vendedor_id])
}

/// Campaña de recuperación de cobranza (Fase 7A). Tabla aditiva, multi-tenant.
/// Agrupa créditos en mora para aplicar acciones masivas (WhatsApp/Email/SMS) y
/// una promoción opcional (quita de interés de mora). La APLICACIÓN automática de
/// la quita al cobrar es Fase 7B (no toca el motor de pagos todavía).
model campanas_cobranza {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  tenant_id        String    @db.Uuid
  vendedor_id      String?   @db.Uuid // dueño de la campaña: vendedor que la creó (null = campaña del admin / toda la financiera)
  nombre           String
  descripcion      String?
  canal            String    @default("whatsapp") // whatsapp | email | sms
  estado           String    @default("borrador") // borrador | activa | finalizada
  promo_tipo       String    @default("ninguna") // ninguna | quita_interes
  promo_valor      Float     @default(0) // % de descuento sobre el interés de mora
  promo_vence      DateTime? @db.Date // plazo límite para acogerse a la promo
  mensaje_template String? // plantilla del mensaje (con [Nombre], [Monto], etc.)
  /**
   * Nombre de la plantilla aprobada por Meta con la que se armó el mensaje (`aviso_mora_ar`),
   * o null si salió como texto libre. Se guarda para poder responder, si Meta observa el
   * número, qué campañas salieron con plantilla aprobada y cuáles no.
   */
  plantilla_meta   String?

  objetivos campana_objetivo[]

  @@index([tenant_id, created_at])
  @@index([tenant_id, vendedor_id])
}

/// Vínculo campaña ↔ crédito en mora (tabla intermedia, Fase 7A). Multi-tenant.
/// Congela un snapshot de la situación de mora al incorporar el crédito a la campaña
/// y la oferta de recuperación calculada. `monto_recuperado` se actualiza con los
/// pagos imputados a ese crédito mientras la campaña esté activa.
model campana_objetivo {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  tenant_id        String    @db.Uuid
  campana_id       String    @db.Uuid
  credito_id       String    @db.Uuid
  // Snapshot de la mora al incorporar a la campaña
  saldo            Float     @default(0) // capital pendiente (NO es lo que se reclama)
  dias_mora        Int       @default(0)
  interes_mora     Float     @default(0)
  /**
   * Lo que está VENCIDO e impago, con mora: capital + interés + cargos de las cuotas que ya
   * vencieron. Es lo que hay que reclamar, y sobre lo que se calcula la oferta.
   * 🔴 La campaña armaba la oferta sobre `saldo` (capital). Es el mismo error que se corrigió
   * en el contacto individual, pero multiplicado por toda la lista: a cada moroso le llegaba
   * una cifra que no coincidía con lo que la caja le iba a cobrar. Nulable porque las
   * campañas viejas no lo tienen.
   */
  vencido          Float?
  cuotas_vencidas  Int?
  // Oferta de recuperación calculada (calculateRecoveryOffer)
  oferta_monto     Float     @default(0) // monto a cancelar con descuento aplicado
  oferta_descuento Float     @default(0) // $ de descuento (ahorro) ofrecido
  /**
   * ── Estado del ENVÍO, por destinatario ──
   * Sin esto, mandar era todo o nada: el endpoint recorría la lista entera en una sola
   * función y Vercel la corta a los 10 segundos. Una campaña de más de ~8 mails moría a la
   * mitad, y como el candado anti-reenvío es por día, los que faltaban no se podían
   * reintentar hasta mañana — sin que la pantalla dijera cuáles quedaron afuera.
   * Ahora cada objetivo lleva su propio estado, así el envío se hace por tandas, se puede
   * retomar donde se cortó y se ve a quién le llegó y a quién no.
   */
  envio_estado     String? // pendiente | enviado | error | manual
  envio_at         DateTime? @db.Timestamptz(6)
  envio_error      String?
  // Seguimiento
  promesa_generada Boolean   @default(false)
  monto_recuperado Float     @default(0)

  campana campanas_cobranza @relation(fields: [campana_id], references: [id], onDelete: Cascade)
  credito creditos          @relation(fields: [credito_id], references: [id], onDelete: Cascade)

  @@unique([campana_id, credito_id])
  @@index([tenant_id, campana_id])
  @@index([tenant_id, credito_id])
}

/// Libro de movimientos de efectivo (Caja) por tenant. Tabla aditiva, multi-tenant.
/// monto con SIGNO: ingreso > 0, egreso < 0. El saldo de caja = suma de monto.
model movimientos_caja {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  tenant_id   String   @db.Uuid
  fecha       DateTime @default(now()) @db.Date
  tipo        String // desembolso | cobro | devolucion | reversa_desembolso | ajuste | transferencia | entrega | rendicion
  monto       Float // con signo: ingreso > 0, egreso < 0
  metodo      String?
  cuenta      String   @default("efectivo") // efectivo | banco | dolares
  descripcion String
  origen      String? // de dónde sale la plata (etiqueta legible: cliente, caja, ajuste…)
  destino     String? // a dónde va la plata (etiqueta legible)
  serie       String? // serie del comprobante (REC, DES, ENT, …)
  numero      Int? // número correlativo dentro de la serie (por tenant) → REC-000123
  credito_id  String?  @db.Uuid
  pago_id     String?  @db.Uuid
  vendedor_id String?  @db.Uuid // dueño de la caja: null = caja principal (tesorería); set = caja personal del vendedor

  // `SetNull`, NO `Cascade`: el libro de caja es append-only y no puede perder asientos
  // porque se borre lo que los originó. Con Cascade, borrar un crédito se llevaba su
  // desembolso: el saldo histórico cambiaba solo, un arqueo viejo dejaba de cuadrar y el
  // comprobante quedaba con un hueco en la numeración. El endpoint ya lo bloquea, pero
  // eso protege UNA puerta; esto lo hace imposible desde cualquiera (script, SQL a mano,
  // endpoint nuevo). Es el mismo criterio con el que ya se protegía `movimientos_stock`.
  // Si se borra el origen, el asiento queda huérfano pero vivo: la descripción y el
  // comprobante conservan a qué correspondía.
  credito  creditos?   @relation(fields: [credito_id], references: [id], onDelete: SetNull)
  pago     pagos?      @relation(fields: [pago_id], references: [id], onDelete: SetNull)
  vendedor vendedores? @relation(fields: [vendedor_id], references: [id], onDelete: SetNull)

  @@unique([tenant_id, serie, numero])
  @@index([tenant_id, fecha])
  @@index([tenant_id, credito_id])
  @@index([tenant_id, cuenta])
  @@index([tenant_id, vendedor_id])
}

/**
 * ARQUEO de caja — el acta de cada cierre: qué decía el sistema, qué se contó, y qué
 * pasó con la diferencia. Tabla aditiva, multi-tenant.
 * Existe por dos razones que `movimientos_caja` no puede cubrir:
 * 1. **Un arqueo que cuadra no es un movimiento de plata**, así que antes no dejaba
 * NINGÚN rastro: se podía cerrar la caja todos los días y no haber forma de probarlo.
 * Acá queda asentado igual, cuadre o no.
 * 2. **El vendedor no puede conciliar su propio faltante.** Si el arqueo del vendedor
 * generara el ajuste solo, sería un botón para hacer desaparecer plata que falta.
 * Por eso su arqueo es una DECLARACIÓN (`pendiente`) y el ajuste lo crea el admin al
 * conciliar. El del admin sí se autoconcilia: es el dueño de la tesorería.
 * `ajuste_id` apunta al `movimientos_caja` que cuadró la diferencia (null si cuadró exacto
 * o si todavía está pendiente). El actor queda congelado como en `auditoria`.
 */
/// PLANILLA DE COBRANZA EN CALLE emitida: el papel que se llevó el cobrador.
///
/// 🔴 POR QUÉ SE PERSISTE
///
/// La planilla salía a la calle y no quedaba rastro de nada: ni qué recorrido se imprimió, ni
/// por cuánta plata, ni quién la mandó. El cobrador volvía con efectivo y papeles escritos a
/// mano y **no había contra qué comparar**. Si faltaba plata, no se podía demostrar.
///
/// Guardarla convierte el papel en un documento con dos lados: se emite por un importe
/// esperado y se RINDE con lo que realmente entró. Es el mismo criterio del arqueo de caja
/// (`arqueos_caja`): un acta que se escribe cuadre o no, y una diferencia que solo un admin
/// puede cerrar con motivo.
///
/// El cobrador NO es usuario del sistema (decisión del usuario, 2026-08-25): la rinde la
/// oficina cuando vuelve el papel. Por eso `cobrador` es texto libre y no una FK.
model planillas_cobranza {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  tenant_id  String   @db.Uuid
  fecha      DateTime @default(now()) @db.Date

  /// Quién sale a cobrar. Texto libre: el cobrador de calle no tiene cuenta en el sistema.
  cobrador      String?
  /// Zonas del recorrido. "__sin__" es el grupo de los clientes sin zona cargada.
  zonas         String[]
  /// Ventana hacia adelante con la que se armó (0 = solo vencidos).
  dias_adelante Int      @default(0)

  /// Lo que la planilla salió a cobrar. Congelado: los punitorios siguen corriendo, así que
  /// mañana el mismo recorrido daría otro número y la rendición no cerraría nunca.
  total_esperado Float
  clientes       Int
  creditos       Int
  /// Snapshot de las filas impresas (mismo criterio que `creditos.cronograma`). Es lo que
  /// permite cargar los cobros después contra lo que REALMENTE decía el papel.
  detalle        Json

  /// emitida | rendida | anulada
  estado String @default("emitida")

  // Quién la emitió (congelado, como en `auditoria`: si se borra la cuenta, el acta se lee igual)
  emitida_por        String? @db.Uuid
  emitida_por_nombre String?

  // ── Rendición: lo que volvió de la calle ──
  rendida_at         DateTime? @db.Timestamptz(6)
  rendido_por        String?   @db.Uuid
  rendido_por_nombre String?
  /// Efectivo que entregó el cobrador, contado en la oficina.
  total_declarado    Float?
  /// declarado − cargado en el sistema. Sobrante > 0, faltante < 0.
  diferencia         Float?
  /// Por qué no cerró. Obligatorio si hay diferencia.
  motivo             String?

  pagos pagos[]

  @@index([tenant_id, created_at])
  @@index([tenant_id, estado])
}

model arqueos_caja {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  tenant_id   String   @db.Uuid
  fecha       DateTime @default(now()) @db.Date
  vendedor_id String?  @db.Uuid // caja arqueada: null = caja principal (tesorería)
  cuenta      String   @default("efectivo") // efectivo | banco | dolares

  saldo_sistema Float // lo que decía el sistema al momento del conteo
  saldo_fisico  Float // lo que se contó realmente
  diferencia    Float // fisico − sistema: sobrante > 0, faltante < 0

  /// cuadrado (dif = 0) | pendiente (dif ≠ 0, esperando al admin) | conciliado (ajuste hecho)
  estado      String  @default("cuadrado")
  observacion String? // nota de quien arqueó
  ajuste_id   String? @db.Uuid // movimiento de ajuste que cerró la diferencia

  // Quién contó (congelado, igual que en `auditoria`: si se borra la cuenta, el acta se lee igual)
  creado_por        String? @db.Uuid
  creado_por_nombre String?

  // Quién concilió la diferencia (solo admin)
  resuelto_por        String?   @db.Uuid
  resuelto_por_nombre String?
  resuelto_at         DateTime? @db.Timestamptz(6)
  resolucion_nota     String? // por qué se ajustó (obligatoria al conciliar)

  vendedor vendedores? @relation(fields: [vendedor_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, created_at])
  @@index([tenant_id, vendedor_id])
  @@index([tenant_id, estado])
}

/// Plan de cuotas PERSISTIDO de un crédito (Fase 6A). Tabla aditiva, multi-tenant.
/// Se genera al otorgar desde construirPlanAmortizacion (congela el cronograma).
/// En 6A las columnas `estado`/`pagado` se DERIVAN en lectura desde los pagos del
/// crédito (capa paralela); quedan persistidas para la imputación cuota-dirigida (6B).
model cuotas {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  tenant_id         String   @db.Uuid
  credito_id        String   @db.Uuid
  nro               Int // número de cuota (1..n)
  fecha_vencimiento DateTime @db.Date
  // Plan congelado (desde construirPlanAmortizacion al generar)
  saldo_inicial     Float // capital pendiente al inicio del período
  capital           Float // abono a capital planificado
  interes           Float // interés planificado del período
  iva               Float    @default(0)
  seguro            Float    @default(0)
  gastos            Float    @default(0)
  cuota_total       Float // cuota total planificada (con redondeo)
  // Estado autoritativo (escrito por el motor de pagos en 6B; en 6A se derivaba).
  estado            String   @default("pendiente") // pendiente | parcial | pagada | vencida
  pagado            Float    @default(0) // total aplicado a la cuota (capital+interes+mora+cargos)
  // Desglose de lo aplicado por componente (Fase 6B)
  pagado_capital    Float    @default(0)
  pagado_interes    Float    @default(0)
  pagado_mora       Float    @default(0)
  pagado_cargos     Float    @default(0)

  credito      creditos     @relation(fields: [credito_id], references: [id], onDelete: Cascade)
  aplicaciones pago_cuota[]

  @@unique([credito_id, nro])
  @@index([tenant_id, credito_id])
  @@index([tenant_id, fecha_vencimiento])
}

/// Aplicación de un pago a una cuota concreta (libro mayor pago↔cuota, Fase 6B).
/// Tabla aditiva, multi-tenant. Permite saber exactamente qué pago canceló qué cuota.
model pago_cuota {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  tenant_id        String   @db.Uuid
  pago_id          String   @db.Uuid
  cuota_id         String   @db.Uuid
  aplicado_capital Float    @default(0)
  aplicado_interes Float    @default(0)
  aplicado_mora    Float    @default(0)
  aplicado_cargos  Float    @default(0)

  pago  pagos  @relation(fields: [pago_id], references: [id], onDelete: Cascade)
  cuota cuotas @relation(fields: [cuota_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, pago_id])
  @@index([tenant_id, cuota_id])
}

model pagos {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  credito_id       String    @db.Uuid
  monto            Float
  fecha            DateTime  @default(now()) @db.Date
  metodo           String    @default("efectivo")
  notas            String?
  tenant_id        String    @db.Uuid
  aplicado_mora    Float     @default(0)
  aplicado_interes Float     @default(0)
  aplicado_cargos  Float     @default(0)
  aplicado_capital Float     @default(0)
  excedente        Float     @default(0)
  // Anulación de pago (tesorería): no se borra, se marca anulado + contra-asiento en caja.
  // Solo dentro de la ventana configurable (cobranza_config.dias_anulacion_pago).
  anulado          Boolean   @default(false)
  anulado_motivo   String?
  anulado_at       DateTime? @db.Timestamptz(6)

  /// Planilla de calle de la que salió este cobro, si se cargó desde una.
  ///
  /// Sin esto la rendición sería a ojo: hay que poder sumar EXACTAMENTE lo que entró por un
  /// recorrido y compararlo contra lo que el cobrador entregó. Nullable porque la enorme
  /// mayoría de los pagos se cobran en el mostrador y no vienen de ninguna planilla.
  planilla_id String?             @db.Uuid
  planilla    planillas_cobranza? @relation(fields: [planilla_id], references: [id], onDelete: SetNull)

  /// Cuota del ACUERDO DE PAGO que se estaba cobrando, si el cobro salió de ahí.
  ///
  /// Las cuotas del acuerdo se marcan pagadas repartiendo el TOTAL cobrado desde que se
  /// armó, así que sin esta columna no había forma de saber qué pago pagó cuál: ni el
  /// recibo ni el historial podían decir "cuota 2 de 3 del acuerdo". Y derivarlo al
  /// imprimir sería frágil — anular un pago viejo remapearía recibos ya entregados.
  ///
  /// SetNull: si el acuerdo se borra, el pago sobrevive (la plata entró igual).
  acuerdo_cuota_id String? @db.Uuid

  credito       creditos           @relation(fields: [credito_id], references: [id], onDelete: Cascade)
  acuerdo_cuota acuerdo_cuota?     @relation(fields: [acuerdo_cuota_id], references: [id], onDelete: SetNull)
  aplicaciones  pago_cuota[]
  movimientos   movimientos_caja[]

  @@index([tenant_id])
}

model solicitudes {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  cliente_id   String    @db.Uuid
  tipo_credito String
  monto        Float
  plazo_meses  Int       @default(12)
  score        Int       @default(0)
  estado       String    @default("pendiente")
  notas        String?
  decided_at   DateTime? @db.Timestamptz(6)
  tenant_id    String    @db.Uuid

  cliente  clientes   @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  creditos creditos[]

  @@index([tenant_id])
}

/// Gestiones de cobranza sobre un crédito en mora (llamadas, promesas de pago, etc.).
/// Tabla aditiva, multi-tenant. Permite historial + recordatorios (proximo_contacto).
model acciones_cobranza {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  tenant_id        String    @db.Uuid
  credito_id       String    @db.Uuid
  tipo             String // llamada | whatsapp | email | visita | otro
  resultado        String // contactado | no_contesta | promesa_pago | renegociacion | ilocalizable | otro
  nota             String?
  promesa_monto    Float?
  promesa_fecha    DateTime? @db.Date
  proximo_contacto DateTime? @db.Date
  automatico       Boolean   @default(false) // true = enviado por el motor automático (cron)
  promesa_estado   String? // pendiente | cumplida | incumplida (solo cuando resultado = promesa_pago)

  credito creditos @relation(fields: [credito_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, credito_id])
  @@index([tenant_id, proximo_contacto])
  @@index([tenant_id, promesa_estado])
}

/**
 * ACUERDO DE PAGO — el arreglo informal con un moroso: "debés $150.000 vencidos, me los
 * pagás en 3 de $50.000". Tabla aditiva, multi-tenant.
 * Llena el hueco entre las dos cosas que ya existían: la **promesa** es un solo pago
 * ("el viernes te pago") y la **refinanciación** cierra el crédito y arma uno nuevo con
 * contrato nuevo. En el medio está lo que se hace todos los días, que es acordar unos
 * pagos sin papeles.
 * 🔴 **NO toca las cuotas del crédito ni el libro de caja.** Es un registro de COMPROMISO,
 * igual que la promesa: el cliente paga por la vía normal (`POST /api/pagos`), la plata se
 * imputa a las cuotas reales como siempre, y el acuerdo se concilia solo comparando lo
 * cobrado desde que se firmó contra lo prometido. Si el acuerdo reescribiera las cuotas,
 * un arreglo de mostrador estaría reescribiendo el crédito.
 * Los términos se CONGELAN al acordar (`congela_punitorios`, `cuotas_para_romper`): que el
 * admin cambie la política después no puede cambiar un acuerdo ya pactado con alguien.
 */
model acuerdos_pago {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  tenant_id   String   @db.Uuid
  credito_id  String   @db.Uuid
  /// Quién lo gestionó: es a quien le corresponde el plus por recupero.
  vendedor_id String?  @db.Uuid
  fecha       DateTime @default(now()) @db.Date

  /// Snapshot de lo VENCIDO al momento de acordar (capital + interés + cargos + mora).
  deuda_original Float
  /// Condonación otorgada como incentivo (sale de la mora/interés, nunca del capital).
  quita          Float @default(0)
  /// Total del PLAN: lo que el cliente se comprometió a pagar en cuotas.
  /// = (deuda_original − quita) + el interés del acuerdo. Decía "= deuda_original − quita",
  /// que dejó de ser cierto cuando el acuerdo pasó a llevar tasa propia.
  monto_acordado Float

  /// ADELANTO cobrado EN EL ACTO al armar el acuerdo (0 si no hubo).
  ///
  /// Es lo primero que hace un cobrador en el mostrador: el cliente trae algo, se le toma, y
  /// el plan se arma sobre lo que queda. Sin esto había que cobrarlo aparte y el acuerdo
  /// quedaba armado sobre una deuda que ya no era la real.
  ///
  /// 🔴 NO ES UN LIBRO PARALELO: la plata entra como un `pagos` normal —imputado a las
  /// cuotas, con su asiento de caja y su comprobante— y `entrega_pago_id` apunta a ese pago.
  /// Este campo es el registro de que ESE cobro fue la entrega de ESTE acuerdo; el importe
  /// autoritativo sigue siendo el del pago.
  entrega         Float   @default(0)
  entrega_pago_id String? @db.Uuid

  /// vigente | cumplido | roto | anulado
  estado        String  @default("vigente")
  motivo_estado String? // por qué se rompió o anuló

  // ── Términos CONGELADOS al acordar ────────────────────────────────────────
  /// Mientras cumple, no se le devengan más punitorios (si la financiera lo permite).
  congela_punitorios Boolean @default(false)
  /// Cuántas cuotas del acuerdo impagas lo dan por roto.
  cuotas_para_romper Int     @default(1)

  notas             String?
  creado_por        String?   @db.Uuid
  creado_por_nombre String?
  cerrado_at        DateTime? @db.Timestamptz(6)

  credito creditos        @relation(fields: [credito_id], references: [id], onDelete: Cascade)
  cuotas  acuerdo_cuota[]

  @@index([tenant_id, credito_id])
  @@index([tenant_id, estado])
  @@index([tenant_id, created_at])
}

/// Cada pago comprometido dentro de un acuerdo. `pagado` se completa conciliando contra
/// los pagos reales del crédito — no es una cuota del crédito ni genera imputación propia.
model acuerdo_cuota {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String   @db.Uuid
  acuerdo_id  String   @db.Uuid
  numero      Int
  vencimiento DateTime @db.Date
  monto       Float
  pagado      Float    @default(0)
  /// pendiente | pagada | vencida
  estado      String   @default("pendiente")

  acuerdo acuerdos_pago @relation(fields: [acuerdo_id], references: [id], onDelete: Cascade)
  pagos   pagos[]

  @@unique([acuerdo_id, numero])
  @@index([tenant_id, acuerdo_id])
  @@index([tenant_id, vencimiento])
}

/// Traza de auditoría: registra eventos de negocio por tenant (tenant_id).
/// Tabla aditiva, solo escritura desde el backend y lectura en la vista.
model auditoria {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  tenant_id      String   @db.Uuid
  entidad        String // clientes | creditos | pagos | configuracion
  entidad_id     String?  @db.Uuid
  accion         String // crear | actualizar | eliminar | cancelar | registrar_pago | actualizar_config
  descripcion    String
  meta           Json?
  usuario_id     String?  @db.Uuid // actor que ejecutó la acción (capturado al escribir)
  usuario_nombre String? // nombre del actor (inmutable, al momento del evento)
  usuario_email  String? // email del actor (inmutable)

  @@index([tenant_id, created_at])
}

/// Proveedores / acreedores (Fase 6). Tabla aditiva, multi-tenant.
/// Cubren tanto gastos operativos como fondeo de la financiera. Cada proveedor
/// tiene una cuenta corriente (movimientos_proveedor) con su saldo.
model proveedores {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  tenant_id  String   @db.Uuid
  nombre     String
  cuit       String?
  email      String?
  telefono   String?
  direccion  String?
  rubro      String? // rubro/categoría (servicios, fondeo, insumos, etc.)
  notas      String?
  activo     Boolean  @default(true)

  movimientos movimientos_proveedor[]

  @@index([tenant_id])
}

/// Cuenta corriente de un proveedor (Fase 6). Tabla aditiva, multi-tenant.
/// monto con SIGNO: cargo > 0 (aumenta lo que le debemos), pago < 0 (lo cancela).
/// El saldo de la cuenta = suma de los montos (positivo = deuda pendiente con el proveedor).
model movimientos_proveedor {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  tenant_id    String   @db.Uuid
  proveedor_id String   @db.Uuid
  fecha        DateTime @default(now()) @db.Date
  tipo         String // cargo (factura/gasto/fondeo recibido) | pago (cancelación)
  monto        Float // con signo: cargo > 0, pago < 0
  concepto     String
  comprobante  String? // N° de factura/comprobante
  metodo       String? // medio de pago (efectivo, transferencia, etc.)

  proveedor proveedores @relation(fields: [proveedor_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, proveedor_id])
  @@index([tenant_id, fecha])
}

/// Configuración del motor financiero por financiera (tenant = tenant_id).
model configuraciones {
  tenant_id             String   @id @db.Uuid
  convencion_tasa       String   @default("nominal_anual")
  sistema_amortizacion  String   @default("frances")
  mora_activa           Boolean  @default(true)
  tasa_mora_diaria      Float    @default(0.01)
  /// Techo de la mora como % del valor de la cuota. 0 = SIN TOPE.
  ///
  /// Default 100: los punitorios nunca superan el valor de la cuota (con 1% diario, se llega
  /// a los 100 días). El porqué está en `CONFIG_DEFAULT` de `lib/domain/config.ts` — sale de
  /// la escalera de recupero, no de una preferencia. Cada financiera lo cambia desde
  /// Configuración → Motor.
  ///
  /// El default de la COLUMNA importa igual que el del dominio: una financiera nueva que
  /// guarde otro bloque de configuración sin tocar el de mora crea la fila sin este campo, y
  /// ahí manda Postgres.
  tope_mora_pct         Float    @default(100)
  base_mora             String   @default("cuota")
  orden_imputacion      String   @default("mora,interes,capital")
  imputar_cargos        String   @default("integrado")
  moneda                String   @default("ARS")
  locale                String   @default("es-AR")
  simulador             Json? // SimuladorConfig (parámetros del motor de cuota por tenant)
  whatsapp_config       Json? // { enabled, token, phone_number_id, business_account_id, templates: { recordatorio, vencimiento, mora_temprana, mora_media, mora_critica } }
  sms_config            Json? // { enabled, api_key, provider }
  email_config          Json? // { enabled, host, port, user, pass } o { enabled, api_key, provider }
  gamificacion_config   Json? // { habilitado, periodo, pesos:{monto,cantidad,cobranza,calidad}, umbrales:{oro,plata,bronce} }
  rentabilidad_config   Json? // { habilitado, costo_fondeo_anual, otros_costos_mensuales } — costo de capital para rentabilidad NETA en Reportes
  riesgo_config         Json? // { politica: PoliticaOriginacion } — motor de riesgo/originación (feature premium; ver lib/domain/riesgo.ts)
  caja_config           Json? // { tope_gasto_vendedor, dias_anulacion_pago } — tesorería: cuánto puede gastar solo un vendedor y hasta cuándo se puede anular un cobro
  cobranza_config       Json? // { dias_sin_gestion } — agenda de cobranza: cada cuántos días un moroso sin gestión vuelve a la cola
  notificaciones_config Json? // { movimientos_caja, respaldos, plan } — qué avisos in-app (campanita) se muestran
  documentos_config     Json? // DocumentosConfig — jurisdicción, punitorios, modo del pagaré y qué cláusulas
  // lleva la solicitud/mutuo. Ver lib/domain/documentos.ts
  updated_at            DateTime @updatedAt @db.Timestamptz(6)
}
