# Next.js
.next/
out/
build/

# Dependencies
node_modules/

# Environment
.env
.env.local
.env*.local

# Operativos locales: secretos (contraseñas) + scripts one-shot de migración/prod
*.local.json
_*.mjs
# ...salvo los HELPERS COMPARTIDOS, que no son one-shot ni tienen secretos: los importan los
# auditores y los backfills, que sí están versionados. Sin ellos, un clon nuevo del repo tiene
# los auditores pero no puede correrlos.
!scripts/_conexion.mjs
!scripts/_indice.mjs

# Misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
next-env.d.ts
*.tsbuildinfo

# Prisma
prisma/*.db

# Documentación interna — sensible (arquitectura, auditoría, planes)
# Se mantienen localmente pero NO se publican en el repo público.
*.md

# Datos reales de clientes + trabajo local de migración (NUNCA publicar: privacidad)
plantillas-migracion/

# Logs del server de desarrollo (Start-Process)
dev-server*.log
